# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casa_pesca
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=cambiar_este_secreto_en_produccion_por_uno_seguro
JWT_EXPIRES_IN=7d

# dLocal Go (https://dlocalgo.com)
# Obtener credenciales en: https://dlocalgo.com/dashboard
DLOCAL_API_KEY=tu_api_key
DLOCAL_SECRET_KEY=tu_secret_key
DLOCAL_BASE_URL=https://api.dlocalgo.com/v1
DLOCAL_NOTIFICATION_URL=http://localhost:4000/api/payments/webhook
DLOCAL_SUCCESS_URL=http://localhost:5173/checkout/success
DLOCAL_BACK_URL=http://localhost:5173/checkout/cancel

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Admin inicial (se crea con el seed)
ADMIN_EMAIL=admin@casapesca.com
ADMIN_PASSWORD=admin123
